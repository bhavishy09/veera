# Vera — environment configuration (copy to .env and fill in)

# Gemini keys: comma-separated list enables rotation (2-3 recommended)
GEMINI_API_KEYS=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# 0 = use Gemini when keys present; 1 = always grounded fallback (offline testing)
DISABLE_LLM=0
COMPOSER_TIMEOUT_S=12

# Server config
PORT=8000
LOG_LEVEL=INFO

# Team identity — FILL BEFORE SUBMISSION (served by GET /v1/metadata)
TEAM_NAME=bot_champ
TEAM_MEMBERS=bhavishya katariya
CONTACT_EMAIL=bhavishyakatariya954@gmail.com

# Layer-1 tuning (safe defaults; tune only against judge_simulator results)
# SILENCE_BAR=0.35
